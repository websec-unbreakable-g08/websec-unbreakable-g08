# Kopieer naar .env en vul eigen waarden in. .env staat in .gitignore.
# Wachtwoorden: enkel letters en cijfers, bv. `openssl rand -hex 16`.

# Publieke URL's zoals de browser ze ziet.
# Server: APP_URL=https://g08.ipv6.thelastgym.be en KC_PUBLIC_URL=https://g08.ipv6.thelastgym.be/auth
APP_URL=http://localhost:8080
KC_PUBLIC_URL=http://localhost:8081/auth

# Keycloak
KC_DB_PASSWORD=changeme
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=changeme
ANNA_PASSWORD=changeme
BRAM_PASSWORD=changeme
CHRIS_PASSWORD=changeme

# OpenFGA
FGA_DB_PASSWORD=changeme
FGA_PRESHARED_KEY=changeme
